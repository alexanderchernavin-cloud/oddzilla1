# Node / pnpm
node_modules/
.pnpm-store/
.pnpm-debug.log
.turbo/
dist/
build/
.next/
out/
coverage/
*.tsbuildinfo

# Go
bin/
*.exe
*.test
*.out

# Env & secrets — ignore every .env variant (incl. .bak / .backup-* dumps),
# keep only the committed template.
.env
.env.*
!.env.example

# Load-test artifacts (cookies contain valid session JWTs while a run is live)
tests/load/*.json

# Docker & data
docker-data/
postgres-data/
redis-data/
caddy-data/
caddy-config/

# Deploy state — pre-deploy pg_dump backups + per-service image stacks
.deploy/

# IDE
.idea/
.vscode/
*.iml

# Claude Code per-user settings
.claude/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/
!apps/web/src/app/admin/logs/

# Local scratch / one-off harnesses (e.g. .scratch/pg-smoke for the
# embedded-Postgres placement→settlement smoke run).
.scratch/

# Team-logo library (~2.5 GB) for the /logos browser. In production Caddy
# serves it from a host-mounted dir (/srv/oddzilla-logos), synced via rsync
# — never committed (would bloat git history + every web image). For local
# `pnpm dev`, regenerate this dir from the source collection with the
# Logos project's sync-to-web.py.
/apps/web/public/logos/

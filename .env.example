# ─────────────────────────────────────────────────────────────────────────────
# Oddzilla — environment template. Copy to `.env` and fill in real values.
# `.env` is gitignored; never commit real secrets.
#
# Each service degrades gracefully when its OPTIONAL vars are absent — see
# the "Optional → effect when absent" table in docs/OPERATIONS.md.
# ─────────────────────────────────────────────────────────────────────────────

# Deployment
NODE_ENV=development
# Caddy hosts. Dev: FRONTEND_HOST=localhost, ADMIN_HOST=admin.localhost.
# Prod: e.g. FRONTEND_HOST=oddzilla.cc, ADMIN_HOST=sadmin.oddzilla.cc.
# Both are required — Caddy refuses to boot if either is empty.
# The Caddyfile also hard-codes a 301 from the legacy `s.oddzilla.cc`
# subdomain to the apex; remove that block if you redeploy under a
# different domain.
FRONTEND_HOST=localhost
ADMIN_HOST=admin.localhost
ACME_EMAIL=admin@localhost               # contact for Let's Encrypt in prod
LOG_LEVEL=info                           # debug|info|warn|error

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_USER=oddzilla
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=oddzilla
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# URL consumed by Drizzle (TS) and pgx (Go). Same DB for every service.
# sslmode=prefer attempts TLS and falls back to plaintext on a server
# that doesn't offer it — safe default for both dev (postgres without
# TLS configured) and prod (postgres with a self-signed cert installed
# per docs/OPERATIONS.md). Tighten to verify-full once a managed CA
# is in place.
DATABASE_URL=postgres://oddzilla:change-me-strong@postgres:5432/oddzilla?sslmode=prefer

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ── Auth (services/api) ───────────────────────────────────────────────────────
# 32+ byte base64 secrets. Generate: `openssl rand -base64 48`
JWT_SECRET=replace-with-openssl-rand-base64-48
REFRESH_COOKIE_SECRET=replace-with-openssl-rand-base64-48
JWT_ACCESS_TTL_SECONDS=900               # 15 minutes
REFRESH_TTL_DAYS=30

# ── Oddin integration (protocol level, no SDK) ────────────────────────────────
# Used by services/feed-ingester and services/settlement.
ODDIN_ENV=integration                    # integration|production
ODDIN_TOKEN=                             # provided by Oddin; AMQP user + x-access-token
ODDIN_CUSTOMER_ID=                       # GET /users/whoami; drives AMQP vhost
ODDIN_NODE_ID=1
ODDIN_LANG=en                            # used by /v1/descriptions/{lang}/...
# Alive-watchdog: max seconds the AMQP feed may be fully silent (no alive
# heartbeat, no odds_change) before feed-ingester suspends the entire active
# catalog. Oddin sends an alive on each producer every ~10s, so 20s = two
# missed beats. Covers token revocation / network partition where the
# OnConnect flush never runs because reconnects fail. <=0 disables it.
FEED_STALE_SUSPEND_SECONDS=20
# AMQP — integration host shown; for production: mq.oddin.gg
ODDIN_AMQP_HOST=mq.integration.oddin.gg
ODDIN_AMQP_PORT=5672                     # AMQPS over 5672 (Oddin convention; not 5671)
ODDIN_AMQP_TLS=true
# REST — integration host shown; for production: https://api-mq.oddin.gg
ODDIN_REST_BASE_URL=https://api-mq.integration.oddin.gg
# Routing key filter (topic-8-section pattern). '#' = all messages.
ODDIN_AMQP_ROUTING_KEY=#
# Settlement runs its own consumer with its own queue; can narrow the
# binding to settlement-family messages only if Oddin starts spamming us.
SETTLEMENT_AMQP_ROUTING_KEY=#

# ── Oddin Disir widgets (services/api → /widgets/*) ──────────────────────────
# Disir is Oddin's prematch + live-scoreboard iframe widget product.
# When DISIR_BRAND_TOKEN is empty, /widgets/* returns 503 widget_disabled
# and the storefront silently skips rendering the iframes — same shape
# as the wallet-watcher gracefully degrading without an RPC URL.
#
# Token is brand-scoped — request a separate one for each Oddin
# environment (integration vs main / production). Every domain that
# embeds the widget must also be whitelisted on Oddin's side; the
# request goes via support@oddin.gg with the list of host names.
DISIR_BASE_URL=https://api-disir.oddin.gg
DISIR_BRAND_TOKEN=
DISIR_ENV=integration                    # integration|main

# ── Oddin BetBuilder (OBB) gRPC (services/api → /betbuilder/*) ──────────────
# OBB lets a punter combine multiple selections from the SAME match into
# one ticket priced by Oddin's correlation model — see
# HumanDocs/Oddin.gg BetBuilder (OBB) documentation.docx.
# When ODDIN_OBB_HOST is empty (or the resolved token is empty),
# /betbuilder/* routes 503 betbuilder_disabled and the storefront hides
# the toggle. Same graceful-idle pattern as Disir.
#
# Production:
#   ODDIN_OBB_HOST=api-obb.oddin.gg:443
# Integration:
#   ODDIN_OBB_HOST=api-obb.integration.oddin.gg:443
#
# The IP allowlist on Oddin's side must include each environment that
# calls OBB — request via your dedicated Oddin channel before flipping
# this on in prod. Token defaults to ODDIN_TOKEN; override only when
# Oddin issues a separate token for OBB.
ODDIN_OBB_HOST=
ODDIN_OBB_TLS=true
ODDIN_TOKEN=
ODDIN_OBB_TOKEN=

# ── Oddin video / Havik player (services/api → /video/*) ────────────────────
# First-party DRM live streams for matches Oddin carries, played in the
# browser by @oddin-gg/havik-player. Empty ODDIN_VIDEO_API_KEY =
# /video/match/:id returns 503 video_disabled and the storefront shows no
# player and no stream tab. Same graceful-idle pattern as Disir + OBB.
#
#   Integration: ODDIN_VIDEO_BASE_URL=https://feed-dev.oddin-video.gg + pk_test_…
#   Production:  ODDIN_VIDEO_BASE_URL=https://feed.oddin-video.gg      + pk_live_…
#
# The key is PUBLISHABLE: Oddin scopes it with a server-side allowed-origin
# list, and the browser SDK needs it in hand because it signs its own DRM
# licence POSTs. The api serves it to the page at runtime (see
# services/api/src/modules/video), so rotating it is an .env edit plus
# `make recreate api` — no storefront rebuild. Every origin that mounts the
# player must be on Oddin's allowed-origin list; ask Oddin to add hosts.
ODDIN_VIDEO_BASE_URL=https://feed-dev.oddin-video.gg
ODDIN_VIDEO_API_KEY=

# ── Wallet / on-chain (services/wallet-watcher + services/signer) ────────────
# Single shared ERC20 receive address users send USDC to. Empty =
# /wallet/deposit-address returns { available: false } and the
# wallet-watcher loop is skipped — the storefront tells the user
# deposits aren't enabled until the operator sets the env. Match the
# format /^0x[0-9a-fA-F]{40}$/ (mixed-case OK).
DEPOSIT_RECEIVE_ADDRESS=
# Ethereum RPC — empty = wallet-watcher idles. Alchemy/Infura/QuickNode all work.
ETH_RPC_URL=
# USDC contract on mainnet. Override for testnets.
ETH_USDC_CONTRACT=0xa0b86991c6218b36c1d19d4a2e9eb0ce3606eb48
ETH_CONFIRMATIONS=12

# HD master key (BIP39 12/24-word phrase) and the signer Unix socket
# are kept for the dormant signer container. The current deposit /
# withdrawal flow is manual (admin-driven), so neither value is
# required to operate the site. Leave empty unless you re-enable the
# signer for a future automated withdrawal feature.
HD_MASTER_MNEMONIC=
SIGNER_SOCKET_PATH=/run/signer/signer.sock

# ── Service tuning (all optional with sensible defaults) ──────────────────────
# odds-publisher: consumer group + batch
ODDS_PUBLISHER_GROUP=odds-publisher
ODDS_PUBLISHER_BATCH=128
# bet-delay: sweep cadence + drift tolerance (basis points; 500 = 5%)
BET_DELAY_SWEEP_MS=1000
BET_DELAY_DRIFT_BP=500
BET_DELAY_BATCH=100
# settlement: rollback chunk size
SETTLEMENT_ROLLBACK_BATCH=100
# settlement: stranded-ticket reconciliation sweeper cadence (seconds).
# Settles `accepted` tickets whose market is terminally settled but whose
# leg result never got written (recovery / bet-delay reorder). <=0 disables.
SETTLEMENT_RECONCILE_INTERVAL_SECONDS=300
# wallet-watcher: poll interval. Post-0032 the service is intent-driven
# (resolves user-submitted tx hashes via eth_getTransactionReceipt) so
# block-range cursors are no longer needed.
WALLET_POLL_MS=5000

# ── ws-gateway abuse caps (all optional; safe defaults baked into code) ───────
# Largest single inbound WS frame in bytes. The biggest legitimate client
# message is a subscribe envelope (a few KiB); this caps a single-frame OOM
# of the 256 MiB container.
WS_MAX_PAYLOAD_BYTES=16384
# Per-connection inbound message rate (token bucket): sustained msgs/sec + burst.
WS_MSG_RATE_PER_SEC=20
WS_MSG_BURST=40
# Max concurrent connections from one client IP (0 disables). Relies on Caddy
# forwarding X-Forwarded-For to /ws (it does, see Caddyfile ws_proxy).
WS_MAX_CLIENTS_PER_IP=50

# ── Service ports (exposed inside Docker network; Caddy fronts them in prod) ──
API_PORT=3001
WS_GATEWAY_PORT=3002
WEB_PORT=3000
FEED_INGESTER_HEALTH_PORT=8081
ODDS_PUBLISHER_HEALTH_PORT=8082
SETTLEMENT_HEALTH_PORT=8083
BET_DELAY_HEALTH_PORT=8084
WALLET_WATCHER_HEALTH_PORT=8085

# ── Frontend (apps/web) ───────────────────────────────────────────────────────
# Browser-side API/WS URLs. Both MUST be empty for production builds —
# Next.js bakes NEXT_PUBLIC_* values into the client bundle at build
# time, so a non-empty value here ships `http://localhost:3001` to every
# browser and breaks in-browser auth. Empty values let api-client fall
# back to `/api` and ws-client to `wss://<host>/ws`, both routed through
# Caddy on the same origin the page was served from.
#
# For local `pnpm dev` (without Docker), set non-empty values in
# `apps/web/.env.local` instead — that file is gitignored and only
# affects the local dev bundle.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=
# Internal URL used by Next.js server components to reach the API over the
# Docker network. In dev set to http://localhost:3001; in Docker set to
# http://api:3001 (Compose DNS resolves the service name).
INTERNAL_API_URL=http://api:3001

# ── CORS (services/api) ───────────────────────────────────────────────────────
# Comma-separated list of origins that can hit the API with credentials.
# Must include every host the web app is served from.
CORS_ORIGINS=http://localhost:3000
# Set to `.oddzilla.cc` in prod so the auth cookie is shared across
# oddzilla.cc and sadmin.oddzilla.cc. Leave empty in dev.
COOKIE_DOMAIN=

# ── FCM push notifications (services/api → Firebase Admin SDK) ──────────────
# Path INSIDE the api container to the Firebase service-account JSON.
# When unset OR the file is missing, the push-outbox worker still runs
# but marks every winning-ticket row with `last_error=firebase_disabled`
# instead of dispatching — the queue drains, no pushes go out, and a
# future restart with credentials in place activates real sending.
#
# Activation (see apps/mobile-android/.../fcm/README.md for the full
# setup):
#   1. Firebase Console → Project settings → Service accounts →
#      Generate new private key. Saves a JSON file.
#   2. Drop it on the host at FIREBASE_SERVICE_ACCOUNT_HOST below
#      (default /srv/oddzilla-firebase/service-account.json), mode 600,
#      owned by the api container's UID (uid 1000 on the standard
#      node:22-alpine base image).
#   3. `make recreate api` to pick up the mount.
#
# FIREBASE_SERVICE_ACCOUNT_HOST is the directory on the host that gets
# bind-mounted (read-only) to /run/firebase inside the api container.
# Mounting a directory (not a file) means a missing service-account
# file doesn't abort docker-compose up — Docker auto-creates the host
# dir if absent. The api looks for /run/firebase/service-account.json.
FIREBASE_SERVICE_ACCOUNT_HOST=/srv/oddzilla-firebase
FIREBASE_SERVICE_ACCOUNT_PATH=/run/firebase/service-account.json

# ── Transactional email (services/api → email-outbox worker) ─────────────────
# Provider-agnostic by design. EMAIL_PROVIDER selects the client
# implementation; EMAIL_PROVIDER_TOKEN is the provider's API key.
#
# When EMAIL_PROVIDER_TOKEN is empty the worker still runs but marks
# every pending row with `last_error=email_disabled` so the queue
# drains — same graceful-idle shape as the push-outbox worker.
#
# Provider options:
#   resend   — https://resend.com. Free tier: 3 000 emails/month,
#              100 emails/day. Send-domain verification required.
#              Token format: `re_xxxxxxxx`.
#   sendgrid — https://sendgrid.com. Free tier: 100 emails/day.
#              Token format: `SG.xxxxx`.
#   ses      — AWS SES via HTTPS API. Pay-per-use ($0.10 / 1 000
#              emails). Token format: AWS access key id; pair with
#              EMAIL_PROVIDER_SECRET for the secret key.
#   smtp     — plain SMTP. Use when bringing your own relay.
#              Token format: `username:password@host:port`.
#
# EMAIL_FROM must be a verified sender on the provider. EMAIL_REPLY_TO
# is optional — defaults to EMAIL_FROM when empty.
#
# EMAIL_PUBLIC_BASE_URL is the user-facing storefront URL the worker
# embeds in verification + reset links. Empty falls back to
# https://${FRONTEND_HOST}; set explicitly when running behind a
# reverse-proxy with a different public hostname.
EMAIL_PROVIDER=resend
EMAIL_PROVIDER_TOKEN=
EMAIL_PROVIDER_SECRET=
EMAIL_FROM=noreply@oddzilla.cc
EMAIL_REPLY_TO=
EMAIL_PUBLIC_BASE_URL=

# ── Inbound email (self-hosted SMTP → backoffice inbox) ─────────────────────
# Migration 0074 adds inbound mail. The mail-receiver service (Go,
# emersion/go-smtp) listens on port 25 of the box and forwards each
# received message to the api's /webhooks/sendgrid-inbound/<SECRET>
# endpoint, shaped exactly like a SendGrid Inbound Parse POST.
#
# Originally designed for SendGrid Inbound Parse, but Twilio rejected
# our SendGrid signup (regional service restrictions). Self-hosting on
# the Hetzner box gives a region/industry-neutral inbound path that no
# third party can revoke. The route slug retains `sendgrid-inbound`
# because the multipart shape IS the contract — when we eventually
# swap providers, the api code doesn't change.
#
# The secret is the only auth gate (no HMAC signature scheme since
# mail-receiver is on the docker network, not exposed publicly).
# Required by both the mail-receiver (paths the secret into its POST)
# AND the api (constant-time compares it, 404 on miss).
#
# Activation:
#   1. Generate the secret:  openssl rand -hex 24
#   2. Paste it below.
#   3. DNS:
#        mail.oddzilla.cc  A   178.104.174.24   (box IP)
#        oddzilla.cc       MX  10 mail.oddzilla.cc.
#      (Drop the legacy SES MX if it's still on oddzilla.cc root.)
#   4. make deploy — mail-receiver comes up, host port 25 binds.
#
# Test: swaks --to support@oddzilla.cc --from you@example.com \
#             --server oddzilla.cc:25 --body 'test'
# The message should land in /admin/emails within seconds.
SENDGRID_INBOUND_SECRET=
# mail-receiver abuse caps. The MX is public + unauthenticated, so cap a
# single source's concurrent connections and message rate (0 disables a cap).
MAIL_MAX_CONNS_PER_IP=10
MAIL_MAX_MSGS_PER_IP_MIN=30

# ── Support AI assistant (services/support-ai-bot — runs on an operator PC) ──
# Migration 0080. The assistant worker polls /webhooks/support-ai/<SECRET>
# from the operator's own PC (outbound HTTPS only — nothing inbound), runs a
# local Gemma model via LM Studio, and posts replies into the live-support
# chat. This token is the only auth gate on those routes (constant-time
# compared, 404 on miss). When empty the routes 503 bot_disabled and the admin
# "Assistant online" indicator stays offline — the chat falls back to humans.
# The SAME value goes in the worker's own services/support-ai-bot/.env.
# Generate: openssl rand -hex 24
SUPPORT_AI_BOT_TOKEN=
# The support assistant runs IN the stack (since 2026-09-01) and needs an
# OpenAI-compatible /v1/chat/completions endpoint. Base URL takes NO /v1
# suffix - the client appends it. Pin the model: auto-discovery takes the
# FIRST entry from /v1/models, which is arbitrary on a multi-model gateway.
# Leave blank and the worker parks (warns, stays healthy, humans handle
# support) rather than crashlooping.
LM_STUDIO_BASE_URL=
LM_STUDIO_MODEL=
LM_STUDIO_API_KEY=

# ZillaBoost graphics-banner worker (migration 0089). The image worker
# (services/zillaboost-banner-gen — operator PC with local LLM + image
# models, outbound HTTPS only) authenticates to /webhooks/banner-gen/<secret>
# with this value. When empty the routes 503 banner_gen_disabled; ticking
# "Generate graphics banner" in the admin still enqueues jobs, which wait
# until the worker can reach them. The SAME value goes in the worker's own
# services/zillaboost-banner-gen/.env. Generate: openssl rand -hex 24
BANNER_GEN_TOKEN=

# NOTE: the graphics worker itself runs on the OPERATOR PC next to
# ComfyUI (which stays bound to 127.0.0.1 — exposing it is admin-level
# RCE) and dials out, exactly like the support-ai bot. Its model
# endpoints live in services/zillaboost-banner-gen/.env on that PC, not
# here. The server side is just the token above + the job queue.

# ── Backups & alerting (consumed by infra/hetzner/backup/*.sh) ────────────────
# pg_backup.sh: optional GPG encryption. Set to a recipient key id and
# the daily dump becomes `.sql.gz.gpg`. Empty = plain gzip.
BACKUP_GPG_RECIPIENT=
# disk_fill_alert.sh: Slack incoming webhook URL. Empty = log only,
# no page. Threshold defaults to 80% of root mount.
SLACK_WEBHOOK_URL=
DISK_FILL_THRESHOLD_PCT=80

# ── Seed / bootstrap accounts (used by `make seed`) ───────────────────────────
SEED_ADMIN_EMAIL=admin@oddzilla.local
SEED_ADMIN_PASSWORD=ChangeMeAdmin123!
SEED_USER_EMAIL=user@oddzilla.local
SEED_USER_PASSWORD=ChangeMeUser123!

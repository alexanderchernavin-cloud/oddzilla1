# Caddy config — multi-host: public frontend + admin backoffice.
#
# For local dev, set `FRONTEND_HOST=localhost` and `ADMIN_HOST=admin.localhost`.
# For production on Hetzner, set both to real hostnames (e.g.
# `oddzilla.cc` and `sadmin.oddzilla.cc`). Caddy will auto-request
# Let's Encrypt certificates on first boot.
#
# A hard-coded `s.oddzilla.cc` block 301s to the apex; the storefront moved
# off the `s.` subdomain in 2026-05 and we keep the redirect so external
# links, search results, and bookmarks survive the cutover. Drop the block
# (and its DNS record) once traffic on the legacy subdomain dies down.

{
	admin off
	email {$ACME_EMAIL}
	# Edge timeouts shed slowloris-style holders so a few thousand
	# half-open sockets don't exhaust ws-gateway / api file
	# descriptors. Read budget is split between header (5s) and body
	# (30s) — enough for legitimate /admin uploads, tight enough that
	# stalled clients drop. WebSocket upgrades inherit `idle` because
	# the upgraded connection no longer counts as an HTTP read.
	servers {
		timeouts {
			read_header 5s
			# 90s upper bound on body read so a 50 MiB support-attachment
			# upload from a 5 Mbps connection completes (the largest
			# legitimate payload — 5 files × 10 MiB on /api/support/me/
			# messages or the admin reply). Slowloris-style holders
			# still drop within reason; legitimate uploads need the
			# headroom.
			read_body   90s
			write       30s
			idle        120s
		}
		max_header_size 16KB
	}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}

# Storefront SSR fan-out. The Next.js layer scales horizontally — three
# Node processes (web1 / web2 / web3) behind one Caddy upstream group.
# Each replica is single-threaded for SSR, so spreading load across
# three matches the CPX31's available cores (the api / postgres / Go
# workers consume the rest). Production starts the extra two replicas
# with `--profile scaled`; local dev runs web1 only, and Caddy's active
# health check marks web2 / web3 unreachable within seconds — traffic
# still flows through the one live upstream.
#
# `lb_policy least_conn` picks the replica with the fewest in-flight
# requests, which matters once one slow SSR render (deep tree, cold
# data cache) holds a worker for hundreds of ms. `lb_try_duration`
# retries the next replica when one returns a connection error so a
# rolling restart doesn't show 502s to users. The health probe hits the
# dedicated /healthz route in apps/web/src/app/healthz/route.ts — a
# stateless 200 that never touches DB or upstream API.
(web_upstream) {
	reverse_proxy web1:3000 web2:3000 web3:3000 {
		lb_policy least_conn
		lb_try_duration 5s
		health_uri /healthz
		health_interval 5s
		health_timeout 2s
		# Overwrite (not append) X-Forwarded-For with the real peer, the
		# same way api_proxy and ws_proxy do. The web tier forwards this
		# value on its server-side /api fetches (lib/server-fetch.ts) so
		# the api's per-IP catalog rate limits key on the visitor rather
		# than on the three replica addresses — without it every SSR
		# render site-wide would share three buckets.
		header_up X-Forwarded-For {remote_host}
	}
}

# Note: Content-Security-Policy is emitted by the Next.js middleware so
# it can mint a per-request nonce and tag the inline theme-boot script.
# Caddy intentionally does NOT set CSP for the web origin; the API origin
# uses @fastify/helmet's strict default-src 'none' policy on /api/*.

# Reverse-proxy snippet for the api container. Used by both host blocks —
# extracted so the two never drift apart.
(api_proxy) {
	handle_path /api/* {
		# Support-chat multipart routes legitimately ship up to 5 ×
		# 10 MiB attachments per request — give them a 60 MiB ceiling
		# (multipart boundary overhead on top of 50 MiB of file
		# bytes). Everything else stays at 1 MiB. The path matcher
		# fires against the post-strip path (handle_path already
		# stripped /api/), so the leading segment is /support or
		# /admin/support.
		@support_uploads path /support/me/messages /admin/support/threads/*/reply
		request_body @support_uploads {
			max_size 60MB
		}
		# The ZillaBoost image worker uploads finished banner graphics as
		# base64 JSON — the 4 MiB decoded cap is ~5.6 MiB encoded. 8 MiB
		# matches the route's own bodyLimit (banner-gen.ts). The first
		# live render (834 KB body) squeaked under the 1 MiB default;
		# a real 3:1 banner would not have.
		@banner_gen_uploads path /webhooks/banner-gen/*/jobs/*/complete
		request_body @banner_gen_uploads {
			max_size 8MB
		}
		# Cap request bodies at the edge — Fastify's per-route default is
		# 1 MiB but slow uploaders still tie up api memory while the body
		# streams in. Matches the largest legitimate admin payload (the
		# 500-entry bulk-logos PUT at ~2 KiB each).
		request_body {
			max_size 1MB
		}
		# Belt + suspenders against browser/proxy caching of authenticated
		# JSON. Fastify routes don't set Cache-Control by default, so a
		# misbehaving CDN or caching proxy could stash a /me / /wallet
		# response and leak it to the next user behind the same NAT. Edge
		# header forces no-store on every API response — EXCEPT the public
		# unauthenticated image byte-serves, whose api-side
		# `public, immutable` header this blanket no-store was silently
		# defeating (both headers reached the browser and no-store wins,
		# so every logo refetched on every page view; found 2026-08-28 via
		# the banner-image route). The logo URLs are content-addressed with
		# a `?v=` stamp, so long caching is safe by construction; a country
		# flag is keyed by the country's name and is immutable outright.
		#
		# ANY NEW PUBLIC IMAGE ROUTE MUST BE ADDED HERE. The failure is
		# silent — the api's own header is correct, both headers arrive,
		# and only a header dump shows which one won. `/catalog/flags/*`
		# (added 2026-09-04) was missed and cost the sidebar a full
		# re-download of every country flag on every render: 105 requests
		# and ~500 KB each time a bettor expanded Football, which is most
		# of why expanding a big sport felt slow on mobile.
		@api_nocache {
			not path /sports/*/logo /competitors/*/logo /tournaments/*/logo /catalog/zillaboost-banners/*/image /catalog/flags/*
		}
		header @api_nocache Cache-Control "no-store"
		# Strip Fastify's X-Powered-By if any handler ever forgets to
		# disable it — small attack-surface reduction (server identity).
		header -X-Powered-By
		reverse_proxy api:3001 {
			# Overwrite (not append) X-Forwarded-For so an attacker can't
			# spoof their inbound IP. {remote_host} is the actual
			# connecting client; combined with `trustProxy: 1` on the
			# Fastify side this pins request.ip to the real client.
			header_up X-Forwarded-For {remote_host}
		}
	}
}

# WebSocket upgrade snippet for ws-gateway. Match /ws exactly, not /ws* —
# the glob also matches /wsanything, /wsedmin, etc. ws-gateway 404s those
# paths anyway, but a tighter matcher keeps the routing surface honest.
(ws_proxy) {
	@websocket {
		header Connection *Upgrade*
		header Upgrade    websocket
	}
	handle /ws {
		reverse_proxy ws-gateway:3002 {
			# Overwrite (not append) X-Forwarded-For with the real peer so
			# ws-gateway's per-IP connection cap keys on the actual client
			# rather than Caddy's address. Mirrors api_proxy above.
			header_up X-Forwarded-For {remote_host}
		}
	}
}

# ── Public frontend ──────────────────────────────────────────────────────────
{$FRONTEND_HOST} {
	encode zstd gzip
	import security_headers
	import api_proxy
	import ws_proxy

	# Android APK distribution. The mobile app polls /app/version.json
	# on launch, compares versionCode against BuildConfig.VERSION_CODE,
	# and downloads /app/oddzilla-<version>.apk via DownloadManager when
	# a newer build is available. Files are served from a host-mounted
	# directory (see docker-compose.yml caddy.volumes) so a release is
	# `scp` + edit-version.json with no Caddy/api restart.
	#
	# version.json: short cache so update prompts propagate within
	#   minutes; APKs: long immutable cache because each release ships
	#   under a versioned filename and never changes content.
	handle_path /app/* {
		root * /srv/oddzilla-apk
		file_server
		@apk path *.apk
		header @apk Cache-Control "public, max-age=86400, immutable"
		header @apk Content-Type "application/vnd.android.package-archive"
		@json path *.json
		header @json Cache-Control "no-store"
		header @json Content-Type "application/json; charset=utf-8"
	}

	handle {
		import web_upstream
	}
}

# ── Legacy storefront redirect (s.oddzilla.cc → oddzilla.cc) ────────────────
# Permanent redirect to preserve external links after the apex migration.
# Caddy will provision a Let's Encrypt cert for s.oddzilla.cc on first boot
# (DNS A record still points at the box). Remove this block — and ask
# Sasha to drop the s.oddzilla.cc DNS record — once the legacy subdomain
# stops receiving meaningful traffic.
s.oddzilla.cc {
	import security_headers
	redir https://oddzilla.cc{uri} 301
}

# ── Admin backoffice ─────────────────────────────────────────────────────────
# Same Next.js container, root redirects to /admin so operators never land on
# marketing pages. Auth + role checks inside /admin routes remain the real
# access control.
{$ADMIN_HOST} {
	encode zstd gzip
	import security_headers
	import api_proxy
	import ws_proxy

	redir / /admin 302

	handle {
		import web_upstream
	}
}

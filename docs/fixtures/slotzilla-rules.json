  "defaultPaytable": {
    "any2:P3": 3500, "all3:P3": 50000,
    "any2:P2": 1800, "all3:P2": 20000,
    "any2:FT": 2200, "all3:FT": 25000,
    "any2:MISS": 900, "all3:MISS": 5500,
    "any2:FOUL": 500, "all3:FOUL": 1800,
    "any2:NONE": 50, "all3:NONE": 100
  }
}

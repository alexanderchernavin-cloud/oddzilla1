# ── Required ─────────────────────────────────────────────────────────
# Public API base INCLUDING the /api prefix.
ODDZILLA_API_BASE=https://oddzilla.cc/api
# Must equal BANNER_GEN_TOKEN in the server's .env (openssl rand -hex 24).
BANNER_GEN_TOKEN=

# ── Local model endpoints (loopback — this worker runs ON the model PC;
#    ComfyUI must never listen beyond 127.0.0.1, see README) ──────────
# LLM for prompt authoring: any OpenAI-compatible /v1/chat/completions
# server. Local LM Studio by default; a hosted gateway works too and is
# the better choice if you would rather not depend on this PC for the
# prompt half (ComfyUI still has to be local).
#
# Auto-discovery takes the FIRST model from /v1/models, which is right for
# a local LM Studio serving one loaded model and wrong for a gateway
# serving several — pin LM_STUDIO_MODEL whenever there is a choice.
LM_STUDIO_BASE_URL=http://127.0.0.1:1234
#LM_STUDIO_MODEL=
# Bearer token. Local LM Studio needs none; a hosted gateway does.
#LM_STUDIO_API_KEY=
#
# Hosted example (note: no /v1 suffix - the code appends it):
#   LM_STUDIO_BASE_URL=https://llm.oddin.gg
#   LM_STUDIO_MODEL=glm-5.3-flash
#   LM_STUDIO_API_KEY=sk-...

# ComfyUI base. A different backend is a one-file swap in src/imagegen.ts.
IMAGE_API_BASE=http://127.0.0.1:8188
# ckpt_name as ComfyUI lists it. KEEP THE FLUX PIN on the RX 7900 XTX
# box: sd3.5_large_fp8_scaled crashes its ROCm kernels
# (hipErrorLaunchFailure, verified 2026-08-28), while FLUX renders fine.
# Unset = auto-discovery, which prefers SD3-family — wrong for that box.
IMAGE_MODEL=flux1-dev-fp8.safetensors

# ── Render shape (defaults suit the storefront banner strips) ────────
# 1920x640 is ~1.2 MP. The old 1152x384 was under half the pixel budget
# these models train at, and under-resourced diffusion is what "AI slop"
# looks like — mushy faces, melted hands, duplicated subjects. Both
# dimensions must stay divisible by 64.
#IMAGE_WIDTH=1920
#IMAGE_HEIGHT=640
#IMAGE_STEPS=28
# Auto: 4.5 for SD3.5, 1.0 for FLUX. Setting it pins the value for both.
#IMAGE_CFG_SCALE=4.5
# FLUX only (the FluxGuidance node). ComfyUI's implicit default is 3.5,
# which over-contrasts and plastics faces; 2.0-2.8 renders naturally.
#IMAGE_FLUX_GUIDANCE=2.5
# ComfyUI sampler_name + scheduler.
#IMAGE_SAMPLER=euler
#IMAGE_SCHEDULER=simple
#IMAGE_NEGATIVE_EXTRA=

# ── Post-render compositing (real crests + real names) ───────────────
# Diffusion cannot draw a legible logo or word at banner scale, so the
# real ones are composited onto the finished plate instead — match /
# market scope only (sport and tournament banners are backdrops the
# storefront lays its own copy over). Set to 0 to ship bare plates.
#BANNER_COMPOSITE=1
# Delivered size: the plate is rendered at IMAGE_WIDTH and downscaled
# here, which sharpens it and keeps the upload well under the 4 MB cap.
#BANNER_OUTPUT_WIDTH=1536
#BANNER_OUTPUT_FORMAT=webp
#BANNER_OUTPUT_QUALITY=92
# Font for the composited team names — must be installed on this PC.
#BANNER_FONT=Segoe UI

# ── Cadence ──────────────────────────────────────────────────────────
# Poll interval while everything is up (ms).
#POLL_INTERVAL_MS=30000
# Backoff while the LOCAL image backend is unreachable (ms). Default 1h —
# queued jobs wait server-side and no attempts are burned meanwhile.
#BACKEND_RETRY_MS=3600000
#REQUEST_TIMEOUT_MS=60000
#IMAGE_TIMEOUT_MS=600000
#WIKIPEDIA_API_BASE=https://en.wikipedia.org/w/api.php

# services/support-ai-bot — runs on the operator PC against LM Studio.
# Copy this file to ".env" in THIS directory and fill it in. This service is
# NOT part of the docker stack; start it with:
#   pnpm --filter @oddzilla/support-ai-bot start

# Public API base, INCLUDING the /api prefix (Caddy proxies /api/* to the API
# and strips the prefix, so the bot's /webhooks/support-ai routes are reachable
# here).
ODDZILLA_API_BASE=https://oddzilla.cc/api

# Shared secret — MUST equal SUPPORT_AI_BOT_TOKEN in the server's .env.
# Generate once with:  openssl rand -hex 24
SUPPORT_AI_BOT_TOKEN=

# Local LM Studio OpenAI-compatible server (Developer tab > Start Server).
LM_STUDIO_BASE_URL=http://localhost:1234
# Leave blank to auto-detect the currently loaded model via /v1/models, or pin
# one explicitly (use the id LM Studio shows for the loaded model):
# LM_STUDIO_MODEL=google/gemma-3-12b
# Most local LM Studio setups need no key; set only if you enabled auth:
# LM_STUDIO_API_KEY=
#
# Any OpenAI-compatible endpoint works, not just LM Studio. Pointing this at
# a hosted gateway is what frees the assistant from depending on this PC
# being awake with a model loaded. Hosted example (no /v1 suffix - the code
# appends it), and pin the model: auto-discovery takes the FIRST entry from
# /v1/models, which is not necessarily the one you want.
#   LM_STUDIO_BASE_URL=https://llm.oddin.gg
#   LM_STUDIO_MODEL=glm-5.3-flash
#   LM_STUDIO_API_KEY=sk-...
#
# Reasoning models (GLM and friends) spend the token budget on an internal
# reasoning pass before emitting content, so keep BOT_MAX_TOKENS generous or
# replies come back empty with finish_reason "length".

# ── Tuning (optional; sane defaults are baked in) ──────────────────────────
# BOT_POLL_INTERVAL_MS=4000
# BOT_HEARTBEAT_INTERVAL_MS=15000
# BOT_PENDING_BATCH=8
# BOT_MAX_REPLY_CHARS=1500
# BOT_TEMPERATURE=0.3
# Default is 50000 (a ceiling: the model stops when the reply is done). Do
# not lower it on a reasoning model: the budget covers the internal reasoning
# pass too, and starving it returns an EMPTY reply with finish_reason
# "length", which the worker hands off to a human. 1024 was enough for small
# talk and too little for "were my last bets bad?" over ten tickets.
# BOT_MAX_TOKENS=50000
# Reasoning + a tool loop is slower than a local non-reasoning model; the
# default gives a long reasoning pass room. Raise further if the bot log shows
# lm_error aborts against a hosted endpoint.
# BOT_LM_TIMEOUT_MS=120000
# LOG_LEVEL=info

# ── web_search tool (Wikipedia; no key needed) ─────────────────────────────
# The assistant can look up real-world facts (past tournament winners, team /
# player / event background) via the keyless Wikipedia API. Override only to
# use a different language edition or a mirror.
# WIKIPEDIA_API_BASE=https://en.wikipedia.org/w/api.php
